{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedapp-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "EventRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventRoom"] }],
  "vars": {
    // every address the static app is served from; the first is the default for links. Their origins may call the API.
    "APP_URLS": "https://bee-talk.app/,https://workszop.github.io/wedapp/",
    // extra browser origins for local development
    "ALLOWED_ORIGINS": "http://localhost:8788"
  }
  // secret (wrangler secret put MASTER_KEY): the operator key that may create events
}
