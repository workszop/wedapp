{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedapp-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "EventRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventRoom"] }],
  "vars": {
    // where the static app is served from; used for the manifest and for links returned to the operator
    "APP_URL": "https://workszop.github.io/wedapp/",
    // browsers allowed to call the API (comma-separated origins)
    "ALLOWED_ORIGINS": "https://workszop.github.io,http://localhost:8788"
  }
  // secret (wrangler secret put MASTER_KEY): the operator key that may create events
}
